# Copy to .env or .env.local (gitignored) and fill with your Supabase project values.
# Dashboard: https://app.supabase.com → Project → Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Legacy alias still supported:
# SUPABASE_KEY=your_anon_public_key

# Server-only — never expose in the frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
HUB_WEB_URL=http://localhost:3002

# Produção (Railway): origens CORS, vírgula, sem barra final
# PRODUCTION_ORIGINS=https://petmi.app,https://hub.petmi.app,https://shift.petmi.app

# Opcional
# LOG_LEVEL=info

# Rate limit global (Railway/produção — opcional)
# GENERAL_RATE_LIMIT_MAX=800
# GENERAL_RATE_LIMIT_WINDOW_MS=900000
# HUB_RATE_LIMIT_MAX=2000
# AUTH_RATE_LIMIT_MAX=5

# Produção — utilizadores de teste/QA isentos de 429 (sub do JWT Supabase, vírgula)
# RATE_LIMIT_BYPASS_USER_IDS=uuid-1,uuid-2
# Aviso nos logs se bypass ultrapassar (não bloqueia): default 5000 req / janela geral
# RATE_LIMIT_BYPASS_MONITOR_MAX=5000

# Dev local (opcional — ver backend/.env.local)
# DISABLE_RATE_LIMIT=true
# HUB_DEV_ONLY=true
# DEBUG_CORS=true

# Assinatura Hub: beta_only (Fundador/pré-lançamento, default) | catalog (planos pagos públicos)
# HUB_SUBSCRIPTION_MODE=beta_only
# Dias de graça em past_due antes de read_history (default 7)
# HUB_PAST_DUE_GRACE_DAYS=7

# Sentry (opcional) — erros 5xx / não operacionais. Sem DSN = no-op.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0

# Staging: use SUPABASE_* de um projeto separado do de produção.
# Ver docs/architecture/HUB_STAGING_AND_BACKUP_RUNBOOK.md

# Mercado Pago — mensalidade do Hub (Checkout de assinatura, sem cartão no nosso site)
# Access token de produção ou TEST-... do painel de credenciais.
# MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook (painel Mercado Pago → Webhooks). Sem ele o aviso é aceito.
# MERCADOPAGO_WEBHOOK_SECRET=
# URL pública deste backend, sem barra final. O webhook fica em /api/public/mercadopago/webhook
# BACKEND_PUBLIC_URL=https://api.seudominio.com
